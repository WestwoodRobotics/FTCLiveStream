# Camera settings, read by ftc-cam.service. Restart the service after changing them.
PORT=8000
WIDTH=1920
HEIGHT=1080
FPS=30
BITRATE=8000000
# One keyframe per second, so a browser joining the stream starts within a second
INTRA=30
# 0 or 180. Prefer the cam page's ?rotate= so the encode stays untouched.
ROTATION=0
# Camera Module 3 only. Remove for the HQ or Global Shutter camera.
FOCUS_ARGS=--autofocus-mode continuous
